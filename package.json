{
  "name": "suzy-says",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prebuild": "node scripts/validate.mjs publish && node scripts/content-state.mjs check",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components config lib page seo style types tests scripts next.config.ts package.json",
    "format:check": "prettier --check app components config lib page seo style types tests scripts next.config.ts package.json",
    "test": "node --test tests/*.test.mjs",
    "validate:dev": "node scripts/validate.mjs dev",
    "validate:media": "node scripts/validate.mjs media",
    "validate:publish": "node scripts/validate.mjs publish",
    "content:update": "node scripts/content-state.mjs update",
    "content:check": "node scripts/content-state.mjs check",
    "package": "node scripts/package.mjs",
    "postbuild": "node scripts/pages-headers.mjs && node scripts/build-seo-manifest.mjs"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "lighthouse": "^13.6.0",
    "parse5": "^8.1.1",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
